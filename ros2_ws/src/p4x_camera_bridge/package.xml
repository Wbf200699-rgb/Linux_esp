<?xml version="1.0"?>
<package format="3">
  <name>p4x_camera_bridge</name>
  <version>0.1.0</version>
  <description>ESP32-P4X-EYE HTTP JPEG to ROS2 compressed and raw images.</description>
  <maintainer email="mark@example.com">mark</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
